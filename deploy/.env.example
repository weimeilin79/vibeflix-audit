# deploy/.env.example — template for deploy/setup_legal_rag.py.
# Copy to deploy/.env (gitignored) and adjust for your project, then run:
#     ./deploy/setup_legal_rag.sh          (or: python deploy/setup_legal_rag.py)

# GCP project that owns the RAG corpus + GCS bucket.
PROJECT=your-project-id
GOOGLE_CLOUD_PROJECT=your-project-id

# ⚠️ RAG Engine is REGIONAL — pick a region (e.g. us-central1), NOT "global".
REGION=us-central1

# GCS bucket used to stage resource/legal/docs/ before import (reused if it exists).
BUCKET=your-artifacts-bucket

# RAG corpus display name (reused on re-run) + the embedding model for it.
CORPUS_DISPLAY_NAME=vibeflix-legal-kb
EMBEDDING_MODEL=publishers/google/models/text-embedding-005

# The script first switches this project+region's RAG Engine to SERVERLESS mode
# (project-level, one-time) because the default Spanner mode is capacity-restricted for
# new projects in us-central1/us-east1/us-east4. If you still get a Spanner/allowlist 400,
# set REGION above to another supported region (e.g. us-west1) — the legal corpus need not
# be co-located with Memory Bank.
