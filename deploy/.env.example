# deploy/.env.example — copy to deploy/.env (gitignored) and fill in for YOUR project:
#
#     cp deploy/.env.example deploy/.env    # then edit
#
# Every deploy script + Terraform module reads this (python-dotenv; real shell env vars
# override it). Nothing has a hardcoded project fallback any more — a script with no
# PROJECT now FAILS LOUDLY rather than silently deploying to whichever project happened
# to be baked into the source.

# ── Target ───────────────────────────────────────────────────────────────────
PROJECT=your-project-id
GOOGLE_CLOUD_PROJECT=your-project-id

# ⚠️ RAG Engine + Memory Bank are REGIONAL — a real region, NOT "global".
# (Separately, the ENGINES run with GOOGLE_CLOUD_LOCATION=global — set in
#  deploy_agents_a2a.py, deliberate. Do NOT "helpfully" pin that to a region: it 403s
#  even with the regional hosts registered and granted.)
REGION=us-central1
RAG_LOCATION=us-central1

# ── Legal RAG corpus (deploy/setup_legal_rag.sh) ─────────────────────────────
# GCS bucket used to stage resource/legal/docs/ before import (reused if it exists).
BUCKET=your-artifacts-bucket

# GCS asset buckets (created by deploy/setup_buckets.sh). GCS names are GLOBALLY unique, so
# leave these UNSET on a fresh project — the scripts default to $PROJECT-request-image /
# $PROJECT-approved-assets, which never collide. Set them only to reuse existing buckets.
#   REQUEST_IMAGE_BUCKET   — console mockup uploads + the default scenario image.
#   APPROVED_ASSETS_BUCKET — an approved image source (brand_style asset-source gate).
# REQUEST_IMAGE_BUCKET=your-project-request-image
# APPROVED_ASSETS_BUCKET=your-project-approved-assets
CORPUS_DISPLAY_NAME=vibeflix-legal-kb
EMBEDDING_MODEL=publishers/google/models/text-embedding-005
# setup_legal_rag.sh PRINTS the corpus resource name — paste it back here:
# RAG_CORPUS=projects/<num>/locations/<region>/ragCorpora/<id>
#
# The script first switches this project+region's RAG Engine to SERVERLESS mode (one-time,
# project-level): the default Spanner mode is capacity-restricted for new projects in
# us-central1/us-east1/us-east4. If you still get a Spanner/allowlist 400, set REGION to
# another supported region (e.g. us-west1) — the legal corpus need not be co-located with
# Memory Bank.

# ── Shared A2A task store ────────────────────────────────────────────────────
# Gates the app's /api/taskstore/* endpoints. The app is --allow-unauthenticated (the
# browser must load the console), so WITHOUT this the agents' A2A task state would be
# world-readable and world-writable.
#   generate:  openssl rand -hex 24
TASK_STORE_KEY=change-me-openssl-rand-hex-24

# ── Observability ────────────────────────────────────────────────────────────
# The traces ARE the demo — every agent must be traced, always. ON BY DEFAULT; only an
# explicit TELEMETRY=off disables it. (It used to be opt-in, and a redeploy that merely
# FORGOT the flag untraced all six engines, reported success, and exited 0.) Also turns on
# prompt/response content capture in the trace view.
TELEMETRY=on

# Propagate the W3C traceparent across every A2A hop, so Cloud Trace stitches the mesh into
# ONE trace and the console's Agent Platform → Topology page can draw the edges (without it:
# "No recent trace connections detected"). Only a VALID + SAMPLED context is injected — an
# unsampled parent makes the callee DROP its own spans, which is what made an earlier
# attempt look like propagation "not working".
A2A_TRACE_PROPAGATION=on

# The A2A SDK's own spans (a2a.server.*). OFF on purpose: they carry NO attributes — they
# name no peer and describe no hop, so they cannot populate any topology query — while
# EventQueue.dequeue_event emits one span per 0.5s of WAITING per in-flight task. Measured
# with them on: 504 of 560 spans (90%) were A2A plumbing, burying the agent spans.
A2A_SDK_SPANS=off
