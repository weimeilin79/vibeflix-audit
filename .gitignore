# Node dependencies and build outputs
node_modules/
dist/
dist-ssr/
*.local
.env
.env.*
!.env.example
!deploy/.env.example
.claude

# ADK local runtime state (sessions, artifacts)
.adk/

# Python virtual environments and caches
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

**/.terraform/

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
data/

# vibeflix-common copies vendored into agent folders at engine-deploy time
agents/*/_vendor/

# Agent Registry tool specs — generated from the LIVE MCP servers by
# deploy/make_toolspec.py (setup_gateway.sh regenerates them on demand)
deploy/toolspecs/
deploy/agent-gateway.yaml
deploy/iap-authz-extension.yaml
# a2a-deploy temp vendor at REPO ROOT only (regenerated every deploy) —
# NOT packages/vibeflix-common/vibeflix_common/, which is the real source.
# NOTE: a trailing '#' comment does NOT work in .gitignore — the whole line is
# the pattern. That is why this used to match nothing.
/vibeflix_common/
packages/vibeflix-common/build/
# setuptools metadata, regenerated by every `pip install -e` / build
*.egg-info/


# Per-project address book — regenerated by deploy/collect_agent_identities.py after each
# deploy. Committing it means a fresh clone starts holding ANOTHER project engine ids and
# identity principals (see the guard in deploy/deploy_agents_a2a.py).
deploy/agent_identities.json

# deploy_mesh.sh per-phase logs + resume state
logs/
.mesh_state
